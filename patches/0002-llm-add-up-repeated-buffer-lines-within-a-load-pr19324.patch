From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niko Lowry <niko@neeks.me>
Date: Mon, 26 Oct 2026 22:13:08 -0400
Subject: [PATCH 2/4] llm: add up repeated buffer lines within a load

memoryParsingWriter stored each buffer line under its component,
backend and kind, so a repeated key overwrote the one before. That
replaces a fit probe's buffers with the final load's, as intended, but
llama.cpp also repeats a key within one load: mmapped weights arrive as
many model lines, and an iSWA model reports its full and
sliding-window caches as two KV lines. Only the last of each counted.

gemma4:31b on Metal prints 62 MTL0_Mapped model lines (17790 MiB) and
two KV lines (10880 + 1275 MiB). Ollama tracked about 5.8 GiB for a
runner using about 33 GiB, which `ollama ps` showed as 5.2 GB and the
scheduler used as the runner's VRAM, overstating free memory.

Lines now add up within a load pass. A model line after any other kind
starts a new pass, and a key's first line in a new pass replaces its
old value, so fit probes are still replaced by the final load. The
pass, rather than adjacency, decides because llama.cpp b12111 prints a
rotation buffer after each KV cache when the cache type is quantized,
which separates an iSWA model's two KV lines.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Ollama-PR: https://github.com/ollama/ollama/pull/19324
---
 llm/llama_server.go      | 25 ++++++++++++--
 llm/llama_server_test.go | 71 ++++++++++++++++++++++++++++++++++++++++
 2 files changed, 94 insertions(+), 2 deletions(-)

diff --git a/llm/llama_server.go b/llm/llama_server.go
index 053782a..2a5a0c4 100644
--- a/llm/llama_server.go
+++ b/llm/llama_server.go
@@ -3082,6 +3082,16 @@ type memoryParsingWriter struct {
 	inner   io.Writer
 	runner  *llamaServerRunner
 	buffers map[memoryBufferKey]memoryBuffer
+
+	// llama.cpp prints one line per buffer, so a key can repeat within one
+	// load: mmapped weights arrive as many model lines, and an iSWA model
+	// reports its full and sliding-window caches as two KV lines, with a
+	// rotation line after each when the cache is quantized. Lines add up
+	// within a pass. A model line after any other kind starts a new pass,
+	// and a key's first line in a new pass replaces its old value, so a
+	// fit probe's buffers give way to the final load's.
+	pass     int
+	lastKind string
 }
 
 type memoryBufferKey struct {
@@ -3092,6 +3102,7 @@ type memoryBufferKey struct {
 
 type memoryBuffer struct {
 	bytes uint64
+	pass  int
 }
 
 // deviceFreeRegex matches per-device free VRAM reported at model load time:
@@ -3172,11 +3183,21 @@ func (w *memoryParsingWriter) Write(b []byte) (int, error) {
 					if w.buffers == nil {
 						w.buffers = make(map[memoryBufferKey]memoryBuffer)
 					}
-					w.buffers[memoryBufferKey{
+					key := memoryBufferKey{
 						component: string(match[1]),
 						backend:   backendName,
 						kind:      string(match[3]),
-					}] = memoryBuffer{bytes: uint64(mib * 1024 * 1024)}
+					}
+					if key.kind == "model" && w.lastKind != "" && w.lastKind != "model" {
+						w.pass++
+					}
+					w.lastKind = key.kind
+
+					bytes := uint64(mib * 1024 * 1024)
+					if prev, ok := w.buffers[key]; ok && prev.pass == w.pass {
+						bytes += prev.bytes
+					}
+					w.buffers[key] = memoryBuffer{bytes: bytes, pass: w.pass}
 					w.updateRunnerMemoryLocked()
 				}
 			}
