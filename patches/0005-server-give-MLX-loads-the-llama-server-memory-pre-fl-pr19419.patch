+
+func TestPredictMemoryFloat32(t *testing.T) {
+	config := `{
+		"num_hidden_layers": 1,
+		"num_attention_heads": 1,
+		"head_dim": 8,
+		"torch_dtype": "float32"
+	}`
+	got, err := predictMemory(testManifest(1), []byte(config), 10)
+	if err != nil {
+		t.Fatal(err)
