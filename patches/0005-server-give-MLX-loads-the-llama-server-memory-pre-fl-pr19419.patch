+		}
+	}`
+	got, err := predictMemory(testManifest(1), []byte(config), 8192)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sliding := uint64(2 * 2 * 256 * 2 * 512)
+	full := uint64(2 * 2 * 512 * 2 * 8192)
+	if want := 3*sliding + full; got.KVCache != want {
